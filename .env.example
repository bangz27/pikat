# Copy to .env.local and fill in. Never commit real keys.
# Leave Supabase vars empty to run with the browser-local fallback (localStorage).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Map tile provider. The public OSM tile server is NOT for production traffic:
# https://operations.osmfoundation.org/policies/tiles/
# Replace with a commercial/self-hosted provider before going to production.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
VITE_TILE_MAX_ZOOM=19
